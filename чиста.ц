зовнішня дія записати_у_файл(дані: адреса<п8>, розмір: природне) -> природне;
зовнішня дія виділити_памʼять(розмір: природне) -> адреса<п8>;
зовнішня дія перевиділити_памʼять(значення: адреса<п8>, розмір: природне) -> адреса<п8>;
зовнішня дія звільнити_памʼять(значення: адреса<п8>);
зовнішня дія надрукувати_природне(значення: природне);
зовнішня дія надрукувати_ціле(значення: ціле);

внутрішня дія виділити<Т>(
  кількість: природне
) -> адреса<Т> {
  вернути виділити_памʼять(кількість * Т.розмір) як адреса<Т>;
}

внутрішня дія перевиділити<Т>(
  значення: адреса<Т>,
  кількість: природне
) -> адреса<Т> {
  вернути перевиділити_памʼять(значення як адреса<п8>, кількість * Т.розмір) як адреса<Т>;
}

внутрішня дія звільнити(
  значення: адреса<ніщо>
) {
  звільнити_памʼять(значення як адреса<п8>);
}

простір Ельф64 {
  @пакована структура ЗаголовокФайла {
    ід0: п8; // 127
    ід1: п8; // 69
    ід2: п8; // 76
    ід3: п8; // 70
    ід4: п8; // Клас бінарника
    ід5: п8; // Порядок байтів
    ід6: п8; // Версія ЕЛЬФ-формату
    ід7: п8; // Наявність АБІ та версії АБІ
    ід8: п8;
    ід9: п8;
    ід10: п8;
    ід11: п8;
    ід12: п8;
    ід13: п8;
    ід14: п8;
    ід15: п8;
    тип: п16; // Тип файлу
    машина: п16; // Архітектура
    версія: п32; // Версія ЕЛЬФ
    па: п64; // Віртуальна адреса початку програми
    зтзп: п64; // Зсув до заголовка програми
    позсек: п64; // Зсув до заголовка секцій
    опції: п32; // Прапори/опції файлу
    розмір_зельф: п16; // Розмір ЕЛЬФ-заголовка
    розмір_тзп: п16; // Розмір заголовка програми
    кількість_тзп: п16; // Кількість заголовків програми
    розмір_тзс: п16; // Розмір заголовка секції
    кількість_тзс: п16; // Кількість заголовків секцій
    позиція_тр: п16; // Індекс секції зістрічного рядка
  }

  @пакована структура ЗаголовокСекції {
    назва: п32; // Індекс назви секції в таблиці рядків
    тип: п32; // Тип секції
    опції: п64; // Прапори секції
    па: п64; // Віртуальна адреса секції у памʼяті
    зсув: п64; // Зсув секції в файлі
    розмір: п64; // Розмір секції в байтах
    посилання: п32; // Індекс повʼязаного розділу
    інфо: п32; // Додаткова інформація, залежна від типу секції
    вирівнювання: п64; // Вирівнювання секції
    розмір_входу: п64; // Розмір запису в секції, якщо є таблиця
  }

  @пакована структура ОписСимвола {
    назва: п32; // Індекс назви символу в таблиці рядків
    інфо: п8; // Тип та звʼязність символу
    інше: п8; // Додаткові дані (рідко використовується)
    позиція: п16; // Номер секції або спеціальне значення
    значення: п64; // Значення символу (адреса або константа)
    розмір: п64; // Розмір символу
  }
}

структура Дані {
  значення: адреса<п8>;
  розмір: природне;
  вмісткість: природне;
}

дія записати_байт_у_дані(дані: адреса<Дані>, значення: п8) {
  якщо дані.розмір == дані.вмісткість {
    дані.вмісткість += 1;
    дані.значення = перевиділити<п8>(дані.значення, дані.вмісткість);
  }
  дані.значення[дані.розмір] = значення;
  дані.розмір += 1;
}

дія записати_байти_у_дані(дані: адреса<Дані>, значення: адреса<п8>, розмір: природне) {
  змінна п = природне(0);

  поки п < розмір {
    записати_байт_у_дані(дані, значення[п]);

    п += 1;
  }
}

дія записати_дані_у_дані(дані: адреса<Дані>, дані1: Дані) {
  записати_байти_у_дані(дані, дані1.значення, дані1.розмір);
}

дія записати_ю8_у_дані(дані: адреса<Дані>, значення: ю8) {
  записати_байти_у_дані(дані, значення.дані, значення.розмір);
}

дія записати_п32_у_дані(дані: адреса<Дані>, значення: п32) {
  записати_байт_у_дані(дані, п8(значення & 255));
  записати_байт_у_дані(дані, п8((значення >> 8) & 255));
  записати_байт_у_дані(дані, п8((значення >> 16) & 255));
  записати_байт_у_дані(дані, п8((значення >> 24) & 255));
}

дія МУВ_РАКС(дані: адреса<Дані>, значення: п32) {
  записати_байт_у_дані(дані, 72);
  записати_байт_у_дані(дані, 199);
  записати_байт_у_дані(дані, 192);
  записати_п32_у_дані(дані, значення);
}

дія МУВ_РДІ(дані: адреса<Дані>, значення: п32) {
  записати_байт_у_дані(дані, 72);
  записати_байт_у_дані(дані, 199);
  записати_байт_у_дані(дані, 199);
  записати_п32_у_дані(дані, значення);
}

дія ЛЕА_РСІ(дані: адреса<Дані>, значення: п32) {
  записати_байт_у_дані(дані, 72);
  записати_байт_у_дані(дані, 141);
  записати_байт_у_дані(дані, 53);
  записати_п32_у_дані(дані, значення);
}

дія МУВ_РДІКС(дані: адреса<Дані>, значення: п32) {
  записати_байт_у_дані(дані, 72);
  записати_байт_у_дані(дані, 199);
  записати_байт_у_дані(дані, 194);
  записати_п32_у_дані(дані, значення);
}

дія СИСКОЛ(дані: адреса<Дані>) {
  записати_байт_у_дані(дані, 15);
  записати_байт_у_дані(дані, 5);
}

дія ІКСОР_РДІ_РДІ(дані: адреса<Дані>) {
  записати_байт_у_дані(дані, 72);
  записати_байт_у_дані(дані, 49);
  записати_байт_у_дані(дані, 255);
}

дія почати() -> ц32 {
  змінна ПОВІДОМЛЕННЯ = ю8"привіт";
  змінна дані: Дані;
  надрукувати_природне(ПОВІДОМЛЕННЯ.розмір);

  дані.значення = виділити<п8>(64);
  дані.розмір = 64;
  дані.вмісткість = 64;

  змінна позиція_тексту = дані.розмір;
  // .текст
  МУВ_РАКС(дані::адреса, 1);
  МУВ_РДІ(дані::адреса, 1);
  ЛЕА_РСІ(дані::адреса, 20);
  МУВ_РДІКС(дані::адреса, п32(ПОВІДОМЛЕННЯ.розмір));
  СИСКОЛ(дані::адреса);
  МУВ_РАКС(дані::адреса, 60);
  ІКСОР_РДІ_РДІ(дані::адреса);
  СИСКОЛ(дані::адреса);

  записати_ю8_у_дані(дані::адреса, ПОВІДОМЛЕННЯ);

  змінна позиція_рядків = дані.розмір;
  // .рядки
  записати_байт_у_дані(дані::адреса, 0);
  записати_ю8_у_дані(дані::адреса, ю8"_початок");
  записати_байт_у_дані(дані::адреса, 0);
  записати_байт_у_дані(дані::адреса, 0);

  змінна позиція_символів = дані.розмір;
  // .символи
  змінна опис_символа: Ельф64::ОписСимвола;

  опис_символа.назва = 0;
  опис_символа.інфо = 0;
  опис_символа.інше = 0;
  опис_символа.позиція = 0;
  опис_символа.значення = 0;
  опис_символа.розмір = 0;
  записати_байти_у_дані(дані::адреса, опис_символа::адреса як адреса<п8>, Ельф64::ОписСимвола.розмір);

  опис_символа.назва = 1;
  опис_символа.інфо = (п8(1) << 4) | 2;
  опис_символа.інше = 0;
  опис_символа.позиція = 1;
  опис_символа.значення = 0;
  опис_символа.розмір = 0;
  записати_байти_у_дані(дані::адреса, опис_символа::адреса як адреса<п8>, Ельф64::ОписСимвола.розмір);

  змінна позиція_назв = дані.розмір;
  // .назви
  записати_байт_у_дані(дані::адреса, 0);
  записати_ю8_у_дані(дані::адреса, ю8".текст");
  записати_байт_у_дані(дані::адреса, 0);
  записати_ю8_у_дані(дані::адреса, ю8".табсим");
  записати_байт_у_дані(дані::адреса, 0);
  записати_ю8_у_дані(дані::адреса, ю8".табряд");
  записати_байт_у_дані(дані::адреса, 0);
  записати_ю8_у_дані(дані::адреса, ю8".табсекряд");
  записати_байт_у_дані(дані::адреса, 0);
  записати_байт_у_дані(дані::адреса, 0);

  змінна позиція_секцій = дані.розмір;
  змінна загс: Ельф64::ЗаголовокСекції;

  загс.назва = 0;
  загс.тип = 0;
  загс.опції = 0;
  загс.па = 0;
  загс.зсув = 0;
  загс.розмір = 0;
  загс.посилання = 0;
  загс.інфо = 0;
  загс.вирівнювання = 0;
  загс.розмір_входу = 0;
  записати_байти_у_дані(дані::адреса, загс::адреса як адреса<п8>, Ельф64::ЗаголовокСекції.розмір);

  загс.назва = 1;
  загс.тип = 1;
  загс.опції = 6;
  загс.па = 0;
  загс.зсув = позиція_тексту;
  загс.розмір = позиція_рядків - позиція_тексту;
  загс.посилання = 0;
  загс.інфо = 0;
  загс.вирівнювання = 1;
  загс.розмір_входу = 0;
  записати_байти_у_дані(дані::адреса, загс::адреса як адреса<п8>, Ельф64::ЗаголовокСекції.розмір);

  загс.назва = 7;
  загс.тип = 2;
  загс.опції = 0;
  загс.па = 0;
  загс.зсув = позиція_символів;
  загс.розмір = позиція_назв - позиція_символів;
  загс.посилання = 3;
  загс.інфо = 1;
  загс.вирівнювання = 8;
  загс.розмір_входу = Ельф64::ОписСимвола.розмір;
  записати_байти_у_дані(дані::адреса, загс::адреса як адреса<п8>, Ельф64::ЗаголовокСекції.розмір);

  загс.назва = 15;
  загс.тип = 3;
  загс.опції = 0;
  загс.па = 0;
  загс.зсув = позиція_рядків;
  загс.розмір = позиція_символів - позиція_рядків;
  загс.посилання = 0;
  загс.інфо = 0;
  загс.вирівнювання = 1;
  загс.розмір_входу = 0;
  записати_байти_у_дані(дані::адреса, загс::адреса як адреса<п8>, Ельф64::ЗаголовокСекції.розмір);

  загс.назва = 23;
  загс.тип = 3;
  загс.опції = 0;
  загс.па = 0;
  загс.зсув = позиція_назв;
  загс.розмір = позиція_секцій - позиція_назв;
  загс.посилання = 0;
  загс.інфо = 0;
  загс.вирівнювання = 1;
  загс.розмір_входу = 0;
  записати_байти_у_дані(дані::адреса, загс::адреса як адреса<п8>, Ельф64::ЗаголовокСекції.розмір);

  змінна ельф_ЗФ = дані.значення як адреса<Ельф64::ЗаголовокФайла>;
  ельф_ЗФ.ід0 = 127;
  ельф_ЗФ.ід1 = 69;
  ельф_ЗФ.ід2 = 76;
  ельф_ЗФ.ід3 = 70;
  ельф_ЗФ.ід4 = 2;
  ельф_ЗФ.ід5 = 1;
  ельф_ЗФ.ід6 = 1;
  ельф_ЗФ.ід7 = 0;
  ельф_ЗФ.ід8 = 0;
  ельф_ЗФ.ід9 = 0;
  ельф_ЗФ.ід10 = 0;
  ельф_ЗФ.ід11 = 0;
  ельф_ЗФ.ід12 = 0;
  ельф_ЗФ.ід13 = 0;
  ельф_ЗФ.ід14 = 0;
  ельф_ЗФ.ід15 = 0;
  ельф_ЗФ.тип = 1;
  ельф_ЗФ.машина = 62;
  ельф_ЗФ.версія = 1;
  ельф_ЗФ.па = 0;
  ельф_ЗФ.зтзп = 0;
  ельф_ЗФ.позсек = позиція_секцій;
  ельф_ЗФ.опції = 0;
  ельф_ЗФ.розмір_зельф = 64;
  ельф_ЗФ.розмір_тзп = 0;
  ельф_ЗФ.кількість_тзп = 0;
  ельф_ЗФ.розмір_тзс = 64;
  ельф_ЗФ.кількість_тзс = 5;
  ельф_ЗФ.позиція_тр = 4;

  записати_у_файл(дані.значення, дані.розмір);

  вернути 0;
}