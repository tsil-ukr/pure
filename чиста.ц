структура Параметр {
  назва: природне;
}

структура Параметри {
  дані: адреса<Параметр>;
  розмір: природне;
}

структура ДаніСполукиДії {
  тип_результату: адреса<Сполука>;
  назва: природне;
  параметри: Параметри;
}

дія почати() -> ц32 {
  змінна ПОВІДОМЛЕННЯ = ю8"привіт!\р";
  змінна дані: Дані;
  надрукувати_природне(ПОВІДОМЛЕННЯ.розмір);

  дані.значення = виділити<п8>(64);
  дані.розмір = 64;
  дані.вмісткість = 64;

  змінна позиція_тексту = дані.розмір;
  // .текст
  МУВ_РАКС(дані::адреса, 1);
  МУВ_РДІ(дані::адреса, 1);
  ЛЕА_РСІ(дані::адреса, 21);
  МУВ_РДІКС(дані::адреса, п32(ПОВІДОМЛЕННЯ.розмір));
  СИСКОЛ(дані::адреса);
  МУВ_РАКС(дані::адреса, 60);
  ІКСОР_РДІ_РДІ(дані::адреса);
  СИСКОЛ(дані::адреса);

  записати_ю8_у_дані(дані::адреса, ПОВІДОМЛЕННЯ);

  змінна позиція_рядків = дані.розмір;
  // .рядки
  записати_байт_у_дані(дані::адреса, 0);
  змінна позиція_рядка__початок = дані.розмір - позиція_рядків;
  записати_ю8_у_дані(дані::адреса, ю8"_початок");
  записати_байт_у_дані(дані::адреса, 0);
  записати_байт_у_дані(дані::адреса, 0);

  змінна позиція_символів = дані.розмір;
  // .символи
  змінна опис_символа = Ельф64::новий_ОпиС();
  записати_байти_у_дані(дані::адреса, опис_символа::адреса як адреса<п8>, Ельф64::ОписСимвола.розмір);

  опис_символа = Ельф64::новий_ОпиС();
  опис_символа.назва = п32(позиція_рядка__початок);
  опис_символа.інфо = (п8(Ельф64::ІНФО_СИМВОЛА_ГЛОБАЛ) << 4) | Ельф64::ТИП_СИМВОЛА_ФУНКЦІЯ;
  опис_символа.позиція = 1;
  записати_байти_у_дані(дані::адреса, опис_символа::адреса як адреса<п8>, Ельф64::ОписСимвола.розмір);

  змінна позиція_назв = дані.розмір;
  // .назви
  записати_байт_у_дані(дані::адреса, 0);
  змінна позиція_назви_текст = дані.розмір - позиція_назв;
  записати_ю8_у_дані(дані::адреса, ю8".текст");
  записати_байт_у_дані(дані::адреса, 0);
  змінна позиція_назви_символи = дані.розмір - позиція_назв;
  записати_ю8_у_дані(дані::адреса, ю8".символи");
  записати_байт_у_дані(дані::адреса, 0);
  змінна позиція_назви_рядки = дані.розмір - позиція_назв;
  записати_ю8_у_дані(дані::адреса, ю8".рядки");
  записати_байт_у_дані(дані::адреса, 0);
  змінна позиція_назви_назви = дані.розмір - позиція_назв;
  записати_ю8_у_дані(дані::адреса, ю8".назви");
  записати_байт_у_дані(дані::адреса, 0);
  записати_байт_у_дані(дані::адреса, 0);

  змінна позиція_секцій = дані.розмір;

  змінна загс = Ельф64::новий_ЗагС();
  записати_байти_у_дані(дані::адреса, загс::адреса як адреса<п8>, Ельф64::ЗаголовокСекції.розмір);

  // .текст
  загс = Ельф64::новий_ЗагС();
  загс.назва = п32(позиція_назви_текст);
  загс.тип = Ельф64::ТИП_СЕКЦІЇ_ПРОГРАМА;
  загс.опції = п64(Ельф64::ОПЦ_СЕКЦІЇ_ВИДІЛ) + Ельф64::ОПЦ_СЕКЦІЇ_ВИКОН;
  загс.зсув = позиція_тексту;
  загс.розмір = позиція_рядків - позиція_тексту;
  загс.вирівнювання = 1;
  записати_байти_у_дані(дані::адреса, загс::адреса як адреса<п8>, Ельф64::ЗаголовокСекції.розмір);

  // .символи
  загс = Ельф64::новий_ЗагС();
  загс.назва = п32(позиція_назви_символи);
  загс.тип = Ельф64::ТИП_СЕКЦІЇ_СИМВОЛИ;
  загс.зсув = позиція_символів;
  загс.розмір = позиція_назв - позиція_символів;
  загс.посилання = 3;
  загс.інфо = 1;
  загс.вирівнювання = 8;
  загс.розмір_входу = Ельф64::ОписСимвола.розмір;
  записати_байти_у_дані(дані::адреса, загс::адреса як адреса<п8>, Ельф64::ЗаголовокСекції.розмір);

  // .рядки
  загс = Ельф64::новий_ЗагС();
  загс.назва = п32(позиція_назви_рядки);
  загс.тип = Ельф64::ТИП_СЕКЦІЇ_РЯДКИ;
  загс.зсув = позиція_рядків;
  загс.розмір = позиція_символів - позиція_рядків;
  загс.вирівнювання = 1;
  записати_байти_у_дані(дані::адреса, загс::адреса як адреса<п8>, Ельф64::ЗаголовокСекції.розмір);

  // .назви
  загс = Ельф64::новий_ЗагС();
  загс.назва = п32(позиція_назви_назви);
  загс.тип = Ельф64::ТИП_СЕКЦІЇ_РЯДКИ;
  загс.зсув = позиція_назв;
  загс.розмір = позиція_секцій - позиція_назв;
  загс.вирівнювання = 1;
  записати_байти_у_дані(дані::адреса, загс::адреса як адреса<п8>, Ельф64::ЗаголовокСекції.розмір);

  змінна ельф_ЗФ = дані.значення як адреса<Ельф64::ЗаголовокФайла>;
  ельф_ЗФ.ід0 = 127;
  ельф_ЗФ.ід1 = 69;
  ельф_ЗФ.ід2 = 76;
  ельф_ЗФ.ід3 = 70;
  ельф_ЗФ.ід4 = 2;
  ельф_ЗФ.ід5 = 1;
  ельф_ЗФ.ід6 = 1;
  ельф_ЗФ.ід7 = 0;
  ельф_ЗФ.ід8 = 0;
  ельф_ЗФ.ід9 = 0;
  ельф_ЗФ.ід10 = 0;
  ельф_ЗФ.ід11 = 0;
  ельф_ЗФ.ід12 = 0;
  ельф_ЗФ.ід13 = 0;
  ельф_ЗФ.ід14 = 0;
  ельф_ЗФ.ід15 = 0;
  ельф_ЗФ.тип = 1;
  ельф_ЗФ.машина = 62;
  ельф_ЗФ.версія = 1;
  ельф_ЗФ.па = 0;
  ельф_ЗФ.зтзп = 0;
  ельф_ЗФ.позсек = позиція_секцій;
  ельф_ЗФ.опції = 0;
  ельф_ЗФ.розмір_зельф = 64;
  ельф_ЗФ.розмір_тзп = 0;
  ельф_ЗФ.кількість_тзп = 0;
  ельф_ЗФ.розмір_тзс = 64;
  ельф_ЗФ.кількість_тзс = 5;
  ельф_ЗФ.позиція_тр = 4;

  записати_у_файл(дані.значення, дані.розмір);

  вернути 0;
}